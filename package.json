{
  "name": "fix-commit",
  "version": "0.1.0",
  "description": "Intelligent pre-commit secret detection and migration tool",
  "author": "fix-commit Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ansarisultan/fix-commit.git"
  },
  "keywords": [
    "security",
    "secrets",
    "git-hooks",
    "pre-commit",
    "api-keys",
    "tokens",
    "migration",
    "fix-commit"
  ],
  "bin": {
    "fix-commit": "./bin/fix-commit.js",
    "secretguard": "./bin/secretguard.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    ".gitignore",
    ".npmignore"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch bin/fix-commit.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"bin/**/*.js\"",
    "build": "npm run format && npm run lint"
  },
  "dependencies": {
    "acorn": "^8.12.1",
    "acorn-walk": "^8.3.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ignore": "^5.3.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "vitest": "^2.0.0"
  }
}
